{
  "image_verify": "enforce",
  "audit": {
    "dir": "/var/lib/moat/audit",
    "max_file_mb": 128,
    "max_total_mb": 2048,
    "max_age": "720h"
  },
  "templates": [
    {
      "name": "default",
      "vcpus": 1,
      "mem_mib": 256,
      "cpu_max": 0.5,
      "mem_max_mib": 512,
      "pids_max": 256
    },
    {
      "name": "build",
      "kernel": "/var/lib/moat/vmlinux",
      "rootfs": "/var/lib/moat/build-rootfs.ext4",
      "vcpus": 4,
      "mem_mib": 4096,
      "cpu_max": 4,
      "mem_max_mib": 4096,
      "disk_bw": 104857600
    },
    {
      "name": "dev-shell",
      "kernel": "/var/lib/moat/vmlinux",
      "rootfs": "/var/lib/moat/dev-shell-rootfs.ext4",
      "vcpus": 2,
      "mem_mib": 1024,
      "cpu_max": 2,
      "mem_max_mib": 1024
    },
    {
      "name": "rhel9",
      "kernel": "/var/lib/moat/vmlinux",
      "rootfs": "/var/lib/moat/rhel9-rootfs.ext4",
      "source": "registry.access.redhat.com/ubi9/ubi@sha256:f405b019ad4f6ebf9097b636e83b363b1f11afe26557b7896fabff954b65a1b8",
      "vcpus": 2,
      "mem_mib": 512
    },
    {
      "name": "python",
      "kernel": "/var/lib/moat/vmlinux",
      "rootfs": "/var/lib/moat/python-rootfs.ext4",
      "source": "docker.io/library/python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217",
      "env": { "PATH": "/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "PYTHONUNBUFFERED": "1" },
      "workdir": "/",
      "default_argv": ["python3"],
      "vcpus": 2,
      "mem_mib": 1024
    }
  ],
  "tokens": [
    {
      "id": "ci",
      "secret": "replace-me-ci",
      "templates": ["default", "build"],
      "max_concurrent": 8,
      "max_ttl": "30m"
    },
    {
      "id": "demo",
      "secret": "replace-me-demo",
      "templates": ["default", "dev-shell"],
      "max_concurrent": 2,
      "max_ttl": "10m",
      "deny_network": true
    },
    {
      "id": "admin",
      "secret": "replace-me-admin",
      "allow_secret_override": true,
      "audit_read": "all"
    }
  ],
  "defaults": {
    "global_max": 64,
    "token_max": 16,
    "default_ttl": "15m",
    "max_ttl": "1h",
    "pool": 4
  }
}
