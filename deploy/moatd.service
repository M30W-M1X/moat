# Moat daemon. install.sh writes this to /etc/systemd/system/moatd.service
# (system) or ~/.config/systemd/user/moatd.service (--user).
#
#   systemctl enable --now moatd
#
# The daemon needs /dev/kvm. For networked sandboxes (-net) or the Firecracker
# jailer (-jail / defaults.jail), also grant network/sys admin capabilities:
#   AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
#   CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
#
# For local-only access without TCP, set "socket": "/run/moat/moatd.sock" in
# /etc/moat/moatd.json and pass -addr "" on ExecStart. For remote access, set
# "tls_cert", "tls_key", and optionally "tls_client_ca" (mTLS) in moatd.json.

[Unit]
Description=Moat microVM sandbox daemon
Documentation=https://moat.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/moatd -config /etc/moat/moatd.json
Restart=on-failure
RestartSec=2

Environment=MOAT_DATA=/var/lib/moat
StateDirectory=moat
RuntimeDirectory=moat
Environment=MOAT_RUN=/run/moat

# Access to the hypervisor device.
DeviceAllow=/dev/kvm rw
DevicePolicy=closed

# Hardening. Loosen these if a sandbox feature needs more.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/moat /run/moat
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=false
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
