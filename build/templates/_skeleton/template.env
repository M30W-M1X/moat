# Settings for build/build-template.sh. This file is sourced as shell.
#
# ROOTFS_SIZE is the ext4 size. Set it well above the installed userland.
# The image is sparse on disk, so a generous size costs little.
ROOTFS_SIZE=256M

# Optional. Override the deterministic pins only when you need a distinct
# filesystem UUID per template.
# FS_UUID=5a5a5a5a-0000-4000-8000-0000000000f0
# HASH_SEED=9b7a6c5d-1e2f-4a3b-8c9d-0e1f2a3b4cf0
